# Copy to .env and adjust. Nothing here is required: the defaults run offline on a
# laptop with no GPU and no API key. Variables are read by agentenv.settings.Settings.

# --- agentenv core ---
AGENTENV_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
AGENTENV_LOG_FORMAT=text           # text | json (one JSON object per line)
AGENTENV_SANDBOX_BACKEND=subprocess  # subprocess (default, no docker needed) | docker
AGENTENV_DOCKER_IMAGE=python:3.12-slim
AGENTENV_DOCKER_EXECUTABLE=docker
AGENTENV_SEED=0                    # seed for deterministic episodes
AGENTENV_WORKSPACE_ROOT=           # empty = a fresh temporary directory per episode

# --- optional model provider (the scripted baseline agent never needs a key) ---
AGENTENV_MODEL_PROVIDER=stub       # stub (default, deterministic) | openai (OpenAI-compatible HTTP)
AGENTENV_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- upstream mini-swe-agent ---
MSWEA_SILENT_STARTUP=1             # hide the upstream startup banner
